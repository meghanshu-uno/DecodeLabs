generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  name           String
  email          String          @unique
  role           String          @default("USER")
  profile        Profile?
  bookmarks      Bookmark[]
  checklistItems ChecklistItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Profile {
  id     String  @id @default(uuid())
  bio    String?
  userId String  @unique
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Track {
  id            String     @id @default(uuid())
  trackId       String     @unique // e.g. track-frontend-arch
  title         String
  category      String
  level         String
  levelLabel    String
  duration      String
  modules       String
  projectsCount String
  rating        Float
  ratingCount   Int
  description   String
  tags          String // JSON array as string or comma separated
  outcomes      String // JSON array as string or newline separated
  capstone      String
  bookmarks     Bookmark[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Consultation {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  status    String   @default("pending") // pending, contacted, closed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, trackId])
}

model ChecklistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String // e.g. "skill-html"
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, itemId])
}
